---
title: ""
description: "Mills is Camilla\u2019s interior design studio: thoughtful, characterful homes designed around the way you really live."
section: "home"
permalink: "/"
layout: base.njk
---
{% from "icons.njk" import svcIcon %}<section class="wrap hero-wrap" style="padding-bottom:128px">
<div class="hero">
<div class="hero-text">
<h1 class="hero-h">{{ home.hero_heading }}</h1>
<p style="font-size:22px;line-height:1.5;max-width:26em;margin:40px 0 0">{{ home.hero_text }}</p>
<div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:36px"><a class="btn btn-clay" href="/contact/">Start a conversation</a><a class="btn btn-line" href="/projects/">See the projects</a></div>
</div>
<div class="hero-media"><div class="fr fr-v5-olive tilt" style="--rot:1deg;--bw0:64px"><div style="height:580px"><img class="cover" src="{{ home.hero_photo.image }}" alt="{{ home.hero_photo.alt }}"></div></div><div class="hero-detail" style="width:240px"><div class="fr fr-v3-clay tilt" style="--rot:-4deg;--bw0:40px"><div style="height:280px"><img class="cover" src="{{ home.hero_small_photo.image }}" alt="{{ home.hero_small_photo.alt }}"></div></div></div></div>
<p class="hero-cap" style="margin:16px 0 0 168px;font-size:14px;color:#000000">{{ home.hero_caption }}</p>
</div>
</section>

<section class="wrap" style="padding-bottom:104px">
<div class="split" style="align-items:start">
<div style="grid-column:2 / span 1;padding-top:12px"><img src="/assets/img/brand/mark-small.svg" alt="" style="width:56px;height:auto;display:block"></div>
<div style="grid-column:3 / span 7">
<p class="dsp" style="font-size:40px;line-height:1.2;font-weight:500">{{ home.intro_headline }}</p>
<p style="margin:32px 0 0;max-width:34em;color:#000000">{{ home.intro_text }}</p>
<p style="margin:28px 0 0"><a class="ulink" href="/about/">More about the studio</a></p>
</div>
</div>
</section>


<section style="background:#44442d;color:#ebe0cf;padding:104px 0 104px">
<div class="wrap split" style="align-items:center">
<div style="grid-column:1 / span 5;margin-top:0"><div class="fr fr-v6-cream tilt reveal" style="--rot:3deg;--bw0:52px;--fbg:#44442d"><div style="height:460px"><img class="cover" src="{{ home.band_photo.image }}" alt="{{ home.band_photo.alt }}"></div></div></div>
<div style="grid-column:7 / span 6">
<h2 class="dsp h-l" style="font-size:clamp(44px,5.6vw,84px);line-height:.95;font-weight:850;letter-spacing:-0.015em;color:#ebe0cf">{{ home.band_heading }}</h2>
<p style="margin:28px 0 0;max-width:30em;color:#cfc5ac">{{ home.band_text }}</p>
<div style="margin-top:36px"><a class="btn btn-paper" href="/services/">How I work</a></div>
</div>
</div>
</section>


<section id="projects" class="wrap" style="padding:104px clamp(20px,4vw,56px) 112px">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:56px">
<h2 class="dsp" style="font-size:56px;line-height:1;font-weight:800">{{ home.projects_heading }}</h2>
<a class="ulink" href="/projects/">See all projects</a>
</div>
<div class="cards">{% set cardStyle = [["v4-olive", -2, 40, 0], ["v5-clay", 1.5, 44, 64], ["v2-clay", -1, 40, 32]] %}{% for c in home.project_cards %}{% set st = cardStyle[loop.index0 % 3] %}<a class="card reveal" href="/projects/{{ c.project }}/" style="display:block;text-decoration:none;color:#000000;margin-top:{{ st[3] }}px"><div class="fr fr-{{ st[0] }} tilt" style="--rot:{{ st[1] }}deg;--bw0:{{ st[2] }}px"><div style=""><div class="zoom" style="aspect-ratio:4/5"><img class="cover" src="{{ c.photo.image }}" alt="{{ c.photo.alt }}"></div></div></div><h3 class="dsp" style="font-size:26px;line-height:1.15;font-weight:700;margin-top:22px">{{ c.title }}</h3><p style="margin:6px 0 0;font-size:14px;color:#000000">{{ c.label }}</p></a>{% endfor %}</div>
</section>


<section id="services" style="background:#844b34;color:#ebe0cf;padding:104px 0 104px">
<div class="wrap">
<div class="split" style="align-items:end;margin-bottom:64px">
<h2 class="dsp h-l" style="grid-column:1 / span 7;font-size:clamp(44px,5.2vw,80px);line-height:.95;font-weight:850;letter-spacing:-0.015em;color:#ebe0cf">{{ home.services_heading }}</h2>
<p style="grid-column:9 / span 4;margin:0;color:#f3dccd">{{ home.services_text }}</p>
</div>
<div class="svc">
{% for s in home.services %}<div style="border-top:1.5px solid #ebe0cf;padding-top:24px"><div class="svc-ico">{{ svcIcon(loop.index0, 60) }}</div><h3 class="dsp" style="font-size:28px;line-height:1.15;font-weight:700;color:#ebe0cf">{{ s.title }}</h3><p style="margin:14px 0 0;color:#f3dccd">{{ s.text }}</p></div>
{% endfor %}</div>
<div style="margin-top:56px"><a class="btn btn-paper-k" href="/services/">See all services</a></div>
</div>
</section>


<section id="about" class="wrap" style="padding:96px clamp(20px,4vw,56px) 104px">
<div class="split" style="align-items:start">
<div style="grid-column:2 / span 4"><div class="fr fr-v6-olive tilt reveal" style="--rot:2deg;--bw0:52px;max-width:400px"><div style="height:420px"><img class="cover" src="{{ home.about_photo.image }}" alt="{{ home.about_photo.alt }}" style="object-position:50% 30%"></div></div></div>
<div style="grid-column:6 / span 6;padding-top:56px">
<p class="dsp" style="font-size:36px;line-height:1.22;font-weight:400">{{ home.about_quote }}</p>
<p style="margin:28px 0 0;max-width:30em;color:#000000">{{ home.about_text }}</p>
<p style="margin:28px 0 0"><a class="ulink" href="/about/">Meet Camilla</a></p>
</div>
</div>
</section>
