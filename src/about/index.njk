---
title: "About"
section: "about"
description: "Meet Camilla, founder of Studio Mills interior design."
layout: base.njk
---
<section class="wrap" style="padding:56px clamp(20px,4vw,56px) 112px">
<div class="split" style="align-items:center;row-gap:56px">
<div style="grid-column:1 / span 6">
<p class="eyebrow" style="margin-bottom:18px">About</p>
<h1 class="pg-h1">{{ about.heading }}</h1>
<p style="margin:32px 0 0;font-size:22px;line-height:1.5;max-width:26em">{{ about.lead }}</p>
<p style="margin:24px 0 0;max-width:32em">{{ about.text }}</p>
<img src="/assets/img/brand/signature.png" alt="Camilla" style="display:block;width:200px;height:auto;margin-top:36px">
</div>
<div style="grid-column:8 / span 5"><div class="fr fr-v5-olive tilt" style="--rot:1.5deg;--bw0:64px"><div><div style="aspect-ratio:4/5"><img class="cover" src="{{ about.portrait_photo.image }}" alt="{{ about.portrait_photo.alt }}" style="object-position:50% 30%"></div></div></div></div>
</div>
</section>

<section class="wrap" style="padding:0 clamp(20px,4vw,56px) 112px">
<div class="split" style="align-items:center;row-gap:48px">
<div style="grid-column:1 / span 6"><div class="fr fr-v3-clay tilt" style="--rot:-1.5deg;--bw0:48px"><div><div style="aspect-ratio:4/3"><img class="cover" src="{{ about.history_photo.image }}" alt="{{ about.history_photo.alt }}"></div></div></div><p class="cap">{{ about.history_caption }}</p></div>
<div style="grid-column:8 / span 5">
<p class="eyebrow">Where it started</p>
<h2 class="dsp" style="font-size:clamp(36px,3.6vw,52px);line-height:1.05;margin:16px 0 0">{{ about.history_heading }}</h2>
<p style="margin:24px 0 0">{{ about.history_text }}</p>
</div>
</div>
</section>

<section style="background:#44442d;color:#ebe0cf;padding:104px 0">
<div class="wrap split" style="align-items:center;row-gap:48px">
<div style="grid-column:1 / span 6">
<p class="eyebrow" style="color:#cfc5ac">What I believe</p>
<p class="dsp" style="font-size:clamp(34px,3.8vw,56px);line-height:1.08;margin:20px 0 0;color:#ebe0cf">{{ about.belief_quote }}</p>
<p style="margin:28px 0 0;color:#cfc5ac;max-width:30em">{{ about.belief_text }}</p>
</div>
<div style="grid-column:8 / span 5"><div class="fr fr-v6-cream tilt" style="--rot:2deg;--bw0:52px;--fbg:#44442d"><div><div style="aspect-ratio:4/5"><img class="cover" src="{{ about.belief_photo.image }}" alt="{{ about.belief_photo.alt }}"></div></div></div></div>
</div>
</section>

<section class="wrap" style="padding:112px clamp(20px,4vw,56px) 112px">
<div class="split" style="align-items:center;row-gap:48px">
<div style="grid-column:2 / span 5">
<p class="eyebrow">How I work</p>
<h2 class="dsp" style="font-size:clamp(36px,3.6vw,52px);line-height:1.05;margin:16px 0 0">{{ about.work_heading }}</h2>
<p style="margin:24px 0 0">{{ about.work_text }}</p>
<div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:32px"><a class="btn btn-clay" href="/services/">See my services</a><a class="btn btn-line" href="/projects/">See the projects</a></div>
</div>
<div style="grid-column:8 / span 4"><div class="fr fr-v4-olive tilt" style="--rot:-1deg;--bw0:48px"><div><div style="aspect-ratio:3/4"><img class="cover" src="{{ about.work_photo.image }}" alt="{{ about.work_photo.alt }}"></div></div></div></div>
</div>
</section>

<section class="wrap" style="padding:0 clamp(20px,4vw,56px) 120px">
<a class="nextp" href="/contact/"><div><p class="eyebrow">Working together</p><p class="dsp" style="font-size:clamp(32px,3.4vw,48px);line-height:1.05;margin:10px 0 0">Let’s talk about your home.</p></div><span class="btn btn-line">Start a conversation</span></a>
</section>
