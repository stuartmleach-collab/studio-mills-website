---
title: "Services"
section: "services"
description: "Full interior design, room-by-room schemes and design consultations from Mills."
layout: base.njk
---
{% from "icons.njk" import svcIcon %}<section class="wrap" style="padding:56px clamp(20px,4vw,56px) 96px">
<div class="split" style="align-items:end;row-gap:24px">
<div style="grid-column:1 / span 7"><p class="eyebrow" style="margin-bottom:18px">Services</p><h1 class="pg-h1">{{ services.heading }}</h1></div>
<p style="grid-column:9 / span 4;margin:0">{{ services.intro }}</p>
</div>
</section>

{% set rowStyle = [["v5-olive", -0.5], ["v3-clay", -1], ["v4-olive", -1.5]] %}{% for r in services.services %}{% set st = rowStyle[loop.index0 % 3] %}<section class="wrap" style="padding:0 clamp(20px,4vw,56px) 112px">
<div class="svc-row{% if loop.index0 % 2 %} rev{% endif %}">
<div class="media"><div class="fr fr-{{ st[0] }} tilt" style="--rot:{{ st[1] }}deg;--bw0:52px"><div><div style="aspect-ratio:4/5"><img class="cover" src="{{ r.photo.image }}" alt="{{ r.photo.alt }}"></div></div></div></div>
<div class="txt"><div style="color:#844b34;margin-bottom:16px">{{ svcIcon(loop.index0, 56) }}</div><h2 class="dsp" style="font-size:clamp(36px,3.6vw,52px);line-height:1.02;margin:0">{{ r.title }}</h2><p style="margin:20px 0 0;font-size:20px;line-height:1.5">{{ r.intro }}</p>
{% if r.includes and r.includes.length %}<ul class="incl">{% for i in r.includes %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
<div class="facts">{% if r.best_for %}<span><b>Best for:</b> {{ r.best_for }}</span>{% endif %}{% if r.fee %}<span><b>Fee:</b> {{ r.fee }}</span>{% endif %}</div>
</div>
</div>
</section>
{% endfor %}
<section style="background:#44442d;color:#ebe0cf;padding:104px 0">
<div class="wrap">
<div class="split" style="align-items:end;row-gap:24px;margin-bottom:56px">
<h2 class="dsp h-l" style="grid-column:1 / span 7;font-size:clamp(40px,4.4vw,64px);line-height:1;color:#ebe0cf">{{ services.steps_heading }}</h2>
<p style="grid-column:9 / span 4;margin:0;color:#cfc5ac">{{ services.steps_intro }}</p>
</div>
<ol class="steps">
{% for st in services.steps %}<li><div class="stepn">{{ loop.index }}</div><h3 class="dsp" style="font-size:26px;margin:16px 0 0;color:#ebe0cf">{{ st.title }}</h3><p style="margin:10px 0 0;color:#cfc5ac">{{ st.text }}</p></li>
{% endfor %}</ol>
</div>
</section>

<section class="wrap" style="padding:104px clamp(20px,4vw,56px) 120px">
<div class="split" style="align-items:center;row-gap:32px">
<div style="grid-column:1 / span 7"><h2 class="dsp" style="font-size:clamp(36px,3.6vw,52px);line-height:1.05;margin:0">{{ services.cta_heading }}</h2><p style="margin:16px 0 0">{{ services.cta_text }}</p></div>
<div style="grid-column:9 / span 4"><a class="btn btn-clay" href="/contact/">Start a conversation</a></div>
</div>
</section>
