<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="preload" href="/assets/fonts/dm-serif-display.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/jost.woff2" as="font" type="font/woff2" crossorigin>
{% raw %}<style id="intro-css">/* Loading screen: olive curtain, three arches rise, then the curtain lifts. Plays on the first page of each visit. */
#intro{position:fixed;inset:0;z-index:100;background:#44442d;display:flex;align-items:center;justify-content:center;animation:curtain .8s cubic-bezier(.7,0,.2,1) 1.5s forwards;pointer-events:none}
#intro svg{width:120px;height:auto;overflow:visible}
#intro path{fill:#ebe0cf;transform-box:fill-box;transform-origin:50% 100%;transform:scaleY(0);animation:archup .55s cubic-bezier(.2,.8,.2,1) forwards}
#intro path:nth-child(2){animation-delay:.18s}#intro path:nth-child(3){animation-delay:.36s}
@keyframes archup{to{transform:scaleY(1)}}
@keyframes curtain{to{transform:translateY(-100%);visibility:hidden}}
.no-intro #intro{display:none}
@media (prefers-reduced-motion:reduce){#intro{display:none}}</style>{% endraw %}
<link rel="stylesheet" href="/assets/css/site.css?v={{ build.version }}">
<script>try{if(sessionStorage.getItem("smIntro"))document.documentElement.classList.add("no-intro");else sessionStorage.setItem("smIntro","1")}catch(e){}</script>
<link rel="icon" href="/assets/img/brand/mark-small.svg" type="image/svg+xml">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}{{ site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
</head>
<body>
<div id="intro" aria-hidden="true"><svg viewBox="0 0 551 476" focusable="false"><path d="M0 476V178.5A84.5 84.5 0 0 1 169 178.5V476Z"/><path d="M179 476V96.5A96.5 96.5 0 0 1 372 96.5V476Z"/><path d="M382 476V178.5A84.5 84.5 0 0 1 551 178.5V476Z"/></svg></div>
<a class="skip" href="#main">Skip to content</a>
<div class="pg" id="top" style="background:#ebe0cf;color:#000000;font-family:Jost,Futura,system-ui,sans-serif;font-size:18px;line-height:1.6">
{% include "header.njk" %}
{% include "menu.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "footer.njk" %}
</div>
<script src="/assets/js/site.js?v={{ build.version }}" defer></script>
</body>
</html>
